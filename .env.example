# =============================================================================
# Backend_dev03 - variables de entorno (copiar a .env y completar)
# Usa IPs PRIVADAS de las EC2 (misma VPC) para la comunicación entre servicios.
# =============================================================================

# --- Imagenes (en CI lo define el workflow; local puede quedar vacío) ---
ECR_REGISTRY=

# --- Kafka ---
# IP privada de ESTA EC2. Es la dirección que Kafka anuncia a ms-ordenes (Backend_dev02).
KAFKA_ADVERTISED_HOST=172.31.x.x
KAFKA_TOPIC_PARTITIONS=3

# --- PostgreSQL (EC2 Data_dev). Cada microservicio crea su propio schema (pagos / recomendaciones) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
DATASOURCE_URL=jdbc:postgresql://IP_DATA_DEV:5432/ecommerce_db

# --- Azure AD (mismo tenant y app que el resto de microservicios) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- CORS: origen(es) del frontend, separados por coma ---
CORS_ALLOWED_ORIGINS=http://IP_FRONTEND,https://xxxx.execute-api.us-east-1.amazonaws.com

# --- Integraciones REST ---
# URL base de ms-ordenes INCLUYENDO /api/v1/ordenes
ORDENES_SERVICE_URL=http://IP_BACKEND_DEV02:8084/api/v1/ordenes
# URL base de ms-productos INCLUYENDO /api/v1/productos
PRODUCTOS_SERVICE_URL=http://IP_BACKEND_DEV:8082/api/v1/productos

# --- Webpay Plus (Transbank) ---
# Valores de integración por defecto. NO subir llaves de producción al repositorio.
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration
# URL PÚBLICA a la que Webpay redirige el navegador del cliente al terminar el pago
TRANSBANK_RETURN_URL=http://IP_PUBLICA_BACKEND_DEV03:8087/api/pagos/retorno
# Origen público del frontend (ms-pagos redirige a FRONTEND_URL/pedidos?paymentStatus=...)
FRONTEND_URL=http://IP_PUBLICA_FRONTEND

# --- RabbitMQ (EC2 Backend_dev02). Solo para enviar eventos de pago a la cola de auditoría ---
RABBITMQ_HOST=IP_BACKEND_DEV02
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Antifraude (velocity check) ---
FRAUD_MAX_ATTEMPTS=3
FRAUD_WINDOW_SECONDS=10
FRAUD_BLOCK_MINUTES=30
